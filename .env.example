# Co-latro backend — runtime environment contract.
# Copy to `.env` for local dev. In production these are injected by the deploy
# tooling (DATABASE_URL is sourced from Vault `kv/poker/db` — never commit a real one).

# HTTP port the server listens on.
PORT=3020

# "development" | "production".
NODE_ENV=development

# Postgres connection string. Local default points at a dev Postgres named "colatro".
# Spin one up with:
#   docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=colatro postgres:17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/colatro

# PET-60: trust-proxy hops for resolving the real client IP behind a reverse proxy
# (Cloudflare tunnel → nginx in the homelab). Needed so the per-IP login rate-limiter
# doesn't see only the proxy IP. Number of trusted hops (e.g. 1), a comma-separated list
# of trusted proxy IPs, or "true". Leave unset/blank for direct/local dev.
# TRUST_PROXY=1
