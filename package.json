{
  "name": "co-latro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Co-latro — authoritative game server (Bun + Express 5 + Drizzle/SQLite)",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "bun-types": "^1.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3"
  }
}
